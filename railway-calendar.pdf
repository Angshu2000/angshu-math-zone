<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Railway Exam Calendar 2026-27 | Angshu Math Zone</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Arial,sans-serif;
 background:linear-gradient(135deg,#eef4ff,#fff7ed,#f5f3ff);
 color:#172033;
}
header{
 background:linear-gradient(135deg,#dc2626,#ef4444,#7c3aed);
 color:white;text-align:center;padding:30px 14px;
}
header h1{margin:0 0 8px;font-size:30px}
header p{margin:0;font-size:15px}
main{max-width:1100px;margin:auto;padding:16px 10px 35px}
.back{
 display:inline-block;margin-bottom:14px;color:#2563eb;text-decoration:none;
 font-weight:700;font-size:17px;
}
.box{
 background:white;border-radius:22px;padding:20px;
 box-shadow:0 8px 28px rgba(15,23,42,.10);
 border:1px solid #e5e7eb;
}
.title{text-align:center;color:#173b78;font-size:29px;margin:2px 0 7px}
.title:after{
 content:"";display:block;width:65px;height:4px;border-radius:5px;
 background:#dc2626;margin:13px auto 12px;
}
.sub{text-align:center;color:#64748b;margin:0 0 20px;font-size:15px}
.actions{text-align:center;margin-bottom:18px}
.btn{
 display:inline-block;text-decoration:none;color:white;font-weight:700;
 padding:11px 17px;border-radius:9px;margin:4px;
 background:linear-gradient(135deg,#dc2626,#b91c1c);
}
.table-wrap{overflow-x:auto;border-radius:14px}
table{width:100%;border-collapse:collapse;min-width:850px;background:#fff}
th{
 background:linear-gradient(135deg,#fee2e2,#ede9fe);
 color:#173b78;padding:13px 10px;text-align:left;
 border:1px solid #cbd5e1;font-size:14px;
}
td{
 padding:13px 10px;border:1px solid #dbe3ef;
 vertical-align:top;font-size:14px;line-height:1.4;
}
tr:nth-child(odd){background:#fff}
tr:nth-child(even){background:#f8fbff}
.period{
 font-weight:700;color:#b91c1c;background:#fff1f2;
}
.category{font-weight:700;color:#1d4ed8}
.date{font-weight:700;color:#15803d}
.note{
 margin-top:18px;padding:14px;border-radius:12px;
 background:#eff6ff;border:1px solid #bfdbfe;color:#1d4ed8;
 line-height:1.5;font-size:14px;
}
.source{
 margin-top:12px;text-align:center;color:#64748b;font-size:12px;
}
footer{background:#111827;color:white;text-align:center;padding:23px 10px}
footer p{margin:5px;font-size:13px}
@media(max-width:600px){
 header{padding:24px 10px}header h1{font-size:24px}
 main{padding:12px 7px 28px}.box{padding:11px}
 .title{font-size:22px}.sub{font-size:13px}
 .back{font-size:15px}
 th,td{font-size:12px;padding:9px 7px}
 .btn{font-size:12px;padding:9px 12px}
}
</style>
</head>
<body>

<header>
 <h1>🚆 Railway Exam Calendar</h1>
 <p>RRB Recruitment Calendar 2026–27</p>
</header>

<main>
 <a class="back" href="exam-calendar.html">← Back to Exam Calendar</a>

 <div class="box">
  <h2 class="title">RRB Exam Calendar 2026–27</h2>
  <p class="sub">
   Railway Recruitment Board — Annual Calendar for RRB Recruitments
